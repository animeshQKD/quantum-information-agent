# Copy this file to .env and fill in the keys you have. Never commit .env (it is in .gitignore).
# Any ONE provider is enough; the agent tries them in PROVIDER_ORDER and falls back automatically.

# Hugging Face Inference Providers (open models; uses your account's credits)
HF_TOKEN=
USE_HF=1
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:deepinfra
HF_FALLBACK_MODEL=openai/gpt-oss-120b:deepinfra
MAX_HF_CALLS=300          # per run (command line); 0 = no cap
DAILY_HF_CALLS=0          # per UTC day; the Space uses 150

# Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Google Gemini (free tier)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Ollama (optional, slow)
USE_OLLAMA=0
OLLAMA_MODEL=qwen3:8b

# OpenAI (PAID; development only, never on the public Space)
OPENAI_API_KEY=
ALLOW_OPENAI=0
MAX_OPENAI_CALLS=20

PROVIDER_ORDER=hf,hf_backup,groq,groq_backup,gemini,ollama

# Web app limits per visitor (0 = no limit)
QUESTIONS_PER_HOUR=0
MAX_QUESTION_CHARS=2000
